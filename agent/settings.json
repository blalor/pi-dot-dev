  "hideThinkingBlock": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "packages": [
    {
      "source": "git:github.com/earendil-works/pi-review",
      "extensions": [
        "+review.ts"
      ]
    },
    "npm:pi-beads-extension@0.1.0",
    "~/Library/Application Support/Sublime Text/Packages/Agent Bridge",
    "npm:pi-subagents",
    "npm:@mjakl/pi-kagi-search",
    "npm:pi-mcp-adapter",
    "npm:pi-worktrunk",
    "git:github.com/blalor/pi-automode@feat/read-only-diagnostics",
