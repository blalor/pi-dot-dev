{
  "enabled": true,
  "filesystem": {
    "denyRead": [
      "~/.config",
      "~/.local"
    ],
    "allowRead": [
      "~/Library/Application Support/Sublime Text/Packages/Agent Bridge/",
      "~/Library/Caches/Sublime Text/Cache/Agent Bridge/connection.json",
      "~/.config/git/",
      "~/.config/gh/",
      "~/.config/gcloud/",
      "/private/tmp/",
      "/tmp/",
      "~/devel/WandB/",
      "~/.cache",
      "/Users/blalor/devel/Personal/pi-dot-dev/"
    ],
    "allowWrite": [
      "/private/tmp/",
      "/tmp/",
      "~/.config/gcloud/logs/",
      "~/.tilt-dev/",
      "~/devel/WandB/",
      "~/.cache"
    ]
  },
  "network": {
    "allowAllUnixSockets": true,
    "allowLocalBinding": true,
    "allowedDomains": [
      "registry.terraform.io",
      "charts.wandb.ai",
      "cdn.wandb.ai",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "*.blob.core.windows.net",
      "*.wandb.dev",
      "circleci.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "charts.loft.sh",
      "artifacthub.io"
    ]
  },
  "audit": {
      "enabled": true,
      "logPath": "~/devel/Personal/pi-dot-dev/landstrip-audit.jsonl",
      "includeCommands": true
  },
  "bypass": {
      "commands": [
          {
              "name": "acli auth status",
              "exact": "acli auth status",
              "reason": "Requires macOS Keychain access"
          },
          {
              "name": "acli jira",
              "regex": "^acli jira ",
              "reason": "Requires macOS Keychain access"
          }
      ]
  }
}
