{
  "enabled": true,
  "filesystem": {
    "denyRead": [
      "~/.config",
      "~/.local"
    ],
    "allowRead": [
      "~/Library/Application Support/Sublime Text/Packages/Agent Bridge/",
      "~/Library/Caches/Sublime Text/Cache/Agent Bridge/connection.json",
      "~/.config/git/",
      "~/devel/Personal/.gitconfig",
      "~/.config/gh/",
      "~/.config/gcloud/",
      "/private/tmp/",
      "/tmp/",
      "~/devel/WandB/",
      "~/.cache",
      "~/.dolt/",
      "~/devel/Personal/pi-dot-dev/",
      "~/.flox/run/",
      "/var/select",
      "/nix/store/",
      "~/.pi/agent/sessions/*/subagent-artifacts/",
      "~/.gnupg/pubring.kbx",
      "~/.orbstack/bin/",
      "~/.docker/"
    ],
    "allowWrite": [
      "/private/tmp/",
      "/tmp/",
      "~/.config/gcloud/logs/",
      "~/.tilt-dev/",
      "~/devel/WandB/",
      "~/.cache",
      "~/.dolt/"
    ]
  },
  "network": {
    "allowAllUnixSockets": true,
    "allowLocalBinding": true,
    "allowedDomains": [
      "registry.terraform.io",
      "charts.wandb.ai",
      "cdn.wandb.ai",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "*.blob.core.windows.net",
      "*.wandb.dev",
      "circleci.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "charts.loft.sh",
      "artifacthub.io"
    ]
  },
  "audit": {
    "enabled": true,
    "logPath": "~/devel/Personal/pi-dot-dev/landstrip-audit.jsonl",
    "includeCommands": true
  },
  "bypass": {
    "commands": [
      {
        "name": "acli auth status",
        "exact": "acli auth status",
        "reason": "Requires macOS Keychain access"
      },
      {
        "name": "acli jira",
        "regex": "^acli jira ",
        "reason": "Requires macOS Keychain access"
      },
      {
        "name": "gh",
        "regex": "^gh ",
        "reason": "Requires macOS Keychain access"
      },
      {
        "name": "git push",
        "regex": "^git push ",
        "reason": "SSH Requires macOS Keychain access"
      }
    ]
  }
}
